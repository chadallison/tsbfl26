.groups = "drop") |>
pivot_wider(id_cols = "team", names_from = "play_type", values_from = c("plays", "total_epa", "epa_pp")) |>
setNames(c("team", "pass_plays", "run_plays", "total_pass_epa", "total_run_epa", "pass_epa_pp", "run_epa_pp")) |>
mutate(pass_balance = pass_plays / (pass_plays + run_plays),
run_balance = run_plays / (pass_plays + run_plays)) |>
mutate_if(is.numeric, round, 3) |>
inner_join(team_color_map, by = "team")
