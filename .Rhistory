ggplot(aes(run_epa_pp, pass_epa_pp)) +
geom_point(aes(col = team_color), shape = "square", size = 4) +
scale_color_identity() +
ggrepel::geom_text_repel(aes(label = team), size = 3, max.overlaps = 32) +
geom_vline(xintercept = 0, linetype = "dashed", alpha = 0.5) +
geom_hline(yintercept = 0, linetype = "dashed", alpha = 0.5) +
labs(x = "Defensive rushing EPA per play",
y = "Defensive passing EPA per play",
title = glue("Defensive pass/run EPA per play as of {today_nice}")) +
scale_x_continuous(breaks = seq(-1, 1, by = 0.05)) +
scale_y_continuous(breaks = seq(-1, 1, by = 0.1))
